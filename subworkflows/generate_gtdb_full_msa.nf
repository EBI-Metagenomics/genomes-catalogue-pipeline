include { GTDBTK_ALIGN         } from '../modules/gtdbtk_align.nf'
include { GTDBTK_IDENTIFY      } from '../modules/gtdbtk_identify.nf'

include { BUILD_TAXONOMY_TREES } from './build_taxonomy_trees.nf'


workflow GENERATE_GTDB_FULL_MSA {

    take:
        genomes
        extension
        reference_db
    main:
    
    GTDBTK_IDENTIFY (
        genomes,
        extension,
        reference_db
    )
    
    GTDBTK_ALIGN (
        GTDBTK_IDENTIFY.out.gtdbtk_msa_folder,
        reference_db
    )
    
    BUILD_TAXONOMY_TREES (
        GTDBTK_ALIGN.out.gtdbtk_user_msa_bac120,
        GTDBTK_ALIGN.out.gtdbtk_user_msa_ar53,
        channel.empty(), // iTOL files are generated by the main BUILD_TAXONOMY_TREES call
        channel.empty(),
        channel.value("bac120_full"),
        channel.value("ar53_full"),
        channel.empty()
    )
}