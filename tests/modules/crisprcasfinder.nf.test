nextflow_process {

    name "Test Process CRISPRCasFinder"
    script "modules/crisprcasfinder.nf"
    process "CRISPRCAS_FINDER"

    test("Should run without failures on genome with numeric suffix") {

        when {
            params {
                outdir = "tests/results"
            }
            process {
                """
                input[0] = channel.from([
                    tuple(
                        "MGYG000000001",
                        file("$baseDir/tests/modules/fixtures/crisprcasfinder/MGYG000299389.1.fna")
                    )
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run without failures") {

        when {
            params {
                outdir = "tests/results"
            }
            process {
                """
                input[0] = channel.from([
                    tuple(
                        "MGYG000000001",
                        file("$baseDir/tests/modules/fixtures/crisprcasfinder/MGYG000299389.fna")
                    )
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
