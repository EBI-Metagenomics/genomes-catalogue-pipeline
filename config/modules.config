/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: CHECKM2_NCBI {
        publishDir = [
        path: "${params.outdir}/additional_data/intermediate_files",
        pattern: "checkm_quality.csv",
        saveAs: { "checkm_quality_ncbi_genomes.csv" },
        mode: 'copy'
        ]
    }
}

process {
    withName: DREP_CATALOGUE {
        publishDir = [
            path: "${params.outdir}/additional_data/intermediate_files",
            pattern: "drep_data_tables.tar.gz",
            mode: 'copy',
            failOnError: true
        ]
    }
}

process {
    withName: IPS_PER_GENOME {
        publishDir = [
            path: {
                def cluster_rep_prefix = id.substring(0, id.length() - 2)
                "${params.outdir}/species_catalogue/${cluster_rep_prefix}/${id}/genome/"
            },
            pattern: "*.IPS.tsv",
            saveAs: { filename -> "${id}_interpro.tsv" },
            mode: 'copy'
        ]
    }
}

process {
    withName: EGGNOG_MAPPER_ANNOTATIONS_PER_GENOME {
        publishDir = [
            path: {
                def cluster_rep_prefix = id.substring(0, id.length() - 2)
                "${params.outdir}/species_catalogue/${cluster_rep_prefix}/${id}/genome/"
            },
            pattern: "*annotations",
            saveAs: { filename -> "${id}_eggNOG.tsv" },
            mode: 'copy'
        ]
    }
}

process {
    withName: GENERATE_EXTRA_WEIGHT {
        publishDir = [
        path: "${params.outdir}/additional_data/intermediate_files/",
        saveAs: { filename -> "extra_weight_table.txt" },
        mode: 'copy',
        enabled: !params.update_catalogue_path ? true : false
        ]
    }
}

process {
    withName: SPLIT_DREP_MAIN {
        publishDir = [
            path: "${params.outdir}/additional_data/intermediate_files",
            pattern: "clusters_split.txt",
            mode: "copy",
            failOnError: true
        ]
    }
}

process {
    withName: SPLIT_DREP_NEW_SPECIES {
        publishDir = [
        path: "${params.outdir}/additional_data/update_execution_reports",
        pattern: "split_output/clusters_split.txt",
        saveAs: { "clusters_split_new_species.txt" },
        mode: "copy",
        failOnError: true
        ]
    }
}

process {
    withName: PARSE_MASH_FOR_UPDATE {
        publishDir = [
        path: "${params.outdir}/additional_data/update_execution_reports",
        pattern: "mash_parse_results/*_strains.tsv",
        mode: 'copy',
        ]
    }
}

process {
    withName: RENAME_FASTA {
        publishDir = [
            path: "${params.outdir}/additional_data/intermediate_files",
            pattern: "*.tsv",
            saveAs: { "renamed_genomes_name_mapping.tsv" },
            mode: 'copy',
            enabled: !params.update_catalogue_path ? true : false,
            failOnError: true
        ]
    }
}

process {
    withName: RUN_CLUSTER_UPDATE {
        publishDir = [
            [
            path: "${params.outdir}/additional_data/intermediate_files",
            pattern: "update_clusters_split.txt",
            saveAs: { "clusters_split.txt" },
            mode: 'copy'
            ],
            [
            path: "${params.outdir}/additional_data/intermediate_files",
            pattern: "extra_weight_table_all_genomes.tsv",
            saveAs: { "extra_weight_table.txt" },
            mode: 'copy',
            enabled: params.update_catalogue_path ? true : false
            ],
            [
            path: "${params.outdir}/additional_data/update_execution_reports",
            pattern: "update_cluster_rep_changes_report.tsv",
            mode: 'copy'
            ],
            [
            path: "${params.outdir}/additional_data/intermediate_files",
            pattern: "update_renamed_genomes_name_mapping.tsv",
            saveAs: { "renamed_genomes_name_mapping.tsv" },
            mode: 'copy',
            enabled: params.update_catalogue_path ? true : false
            ]
        ]
    }
}

process {
    withName: BRAKER {
        publishDir = [
            path: "${params.outdir}/additional_data/intermediate_files/braker/",
            saveAs: { filename -> "${genome_name}/${filename.tokenize('/')[-1]}" },
            mode: 'copy',
            failOnError: true
        ]
    }
}

process {
    withName: METAEUK {
        publishDir = [
            path: "${params.outdir}/additional_data/intermediate_files/metaeuk/",
            saveAs: { filename -> filename.tokenize('/')[-1] },
            mode: 'copy',
            failOnError: true
        ]
    }
}

process {
    withName: PSAURON {
        publishDir = [
            path: "${params.outdir}/additional_data/intermediate_files/psauron",
            pattern: "*.psauron.csv",
            mode: 'copy',
            failOnError: true
        ]
    }
}

process {
    withName: MERGE_GENE_PREDICTIONS {
        publishDir = [
            path: "${params.outdir}/additional_data/intermediate_files/merged_gene_predictions/",
            saveAs: { filename -> filename.tokenize('/')[-1] },
            mode: 'copy',
            failOnError: true
        ]
    }
}

process {
    withName: POSTPROCESSING_GENE_CALLER {
        publishDir = [
            // Representative proteins and genome go into the species_catalogue genome folder
            [
                path: {
                    def cluster_prefix = cluster_name.substring(0, cluster_name.length() - 2)
                    "${params.outdir}/species_catalogue/${cluster_prefix}/${cluster_name}/genome"
                },
                pattern: "*.{faa,fna}",
                saveAs: { filename -> genome_name == cluster_name ? filename : null },
                mode: 'copy',
                failOnError: true
            ],
            // Collection of every catalogue genome (reps + non-reps), used by the update workflow
            [
                path: "${params.outdir}/additional_data/mgyg_genomes",
                pattern: "*.fna",
                mode: 'copy',
                failOnError: true
            ],
            [
                path: "${params.outdir}/additional_data/intermediate_files/ffn_files",
                pattern: "*.ffn",
                mode: 'copy',
                failOnError: true
            ],
            [
                path: {
                    def cluster_prefix = cluster_name.substring(0, cluster_name.length() - 2)
                    "${params.outdir}/all_genomes/${cluster_prefix}/${cluster_name}"
                },
                pattern: "*.gff",
                saveAs: { filename -> genome_name == cluster_name ? null : filename },
                mode: 'copy',
                failOnError: true
            ]
        ]
    }
}
