/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: CHECKM2_NCBI {
        publishDir = [
        path: "${params.outdir}/additional_data/intermediate_files",
        pattern: "checkm_quality.csv",
        saveAs: { "checkm_quality_ncbi_genomes.csv" },
        mode: 'copy'
        ]
    }
}

process {
    withName: DREP_CATALOGUE {
        publishDir = [
            path: "${params.outdir}",
            saveAs: { filename ->
                def result_file = file(filename)
                if ( result_file.name == "drep_data_tables.tar.gz" ) {
                    return "additional_data/intermediate_files/drep_data_tables.tar.gz"
                }
                return null
            },
            mode: 'copy',
            failOnError: true
        ]
    }
}

process {
    withName: IPS_PER_GENOME {
        publishDir = [
            path: "${params.outdir}/interpro",
            pattern: "*.IPS.tsv",
            mode: 'copy'
        ]
    }
}

process {
    withName: EGGNOG_MAPPER_ANNOTATIONS_PER_GENOME {
        publishDir = [
            path:"${params.outdir}/eggnog",
            pattern: "*annotations",
            mode: 'copy'
        ]
    }
}

process {
    withName: GENERATE_EXTRA_WEIGHT {
        publishDir = [
        path: "${params.outdir}/additional_data/intermediate_files/",
        saveAs: { filename -> "extra_weight_table.txt" },
        mode: 'copy',
        enabled: !params.update_catalogue_path ? true : false
        ]
    }
}

process {
    withName: SPLIT_DREP_MAIN {
        publishDir = [
        path: "${params.outdir}",
        saveAs: { filename -> 
            def output_file = file(filename)
            if ( output_file.name == "clusters_split.txt" ) {
                return "additional_data/intermediate_files/clusters_split.txt"
            }
            return null
        },
        mode: "copy",
        failOnError: true
        ]
    }
}

process {
    withName: RENAME_FASTA {
        publishDir = [
        path: "${params.outdir}",
        pattern: "*.tsv",
        saveAs: { "additional_data/intermediate_files/renamed_genomes_name_mapping.tsv" },
        mode: 'copy',
        enabled: !params.update_catalogue_path ? true : false,
        failOnError: true
        ]
    }
}

process {
    withName: RUN_CLUSTER_UPDATE {
        publishDir = [
            [
            path: "${params.outdir}/additional_data/intermediate_files",
            pattern: "update_clusters_split.txt",
            saveAs: { "clusters_split.txt" },
            mode: 'copy'
            ],
            [
            path: "${params.outdir}/additional_data/intermediate_files",
            pattern: "extra_weight_table_all_genomes.tsv",
            saveAs: { "extra_weight_table.txt" },
            mode: 'copy',
            enabled: params.update_catalogue_path ? true : false
            ],
            [
            path: "${params.outdir}/additional_data/update_execution_reports",
            pattern: "update_cluster_rep_changes_report.tsv",
            mode: 'copy'
            ],
            [
            path: "${params.outdir}/additional_data/intermediate_files",
            pattern: "update_renamed_genomes_name_mapping.tsv",
            saveAs: { "renamed_genomes_name_mapping.tsv" },
            mode: 'copy',
            enabled: params.update_catalogue_path ? true : false
            ]
        ]
    }
}