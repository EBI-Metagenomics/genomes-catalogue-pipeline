/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: CHECKM2_NCBI {
        publishDir = [
        path: "${params.outdir}/additional_data/intermediate_files",
        pattern: "checkm_quality.csv",
        saveAs: { "checkm_quality_ncbi_genomes.csv" },
        mode: 'copy'
        ]
    }
}

process {
    withName: DREP_CATALOGUE {
        publishDir = [
            path: "${params.outdir}/additional_data/intermediate_files",
            pattern: "drep_data_tables.tar.gz",
            mode: 'copy',
            failOnError: true
        ]
    }
}

process {
    withName: IPS_PER_GENOME {
        publishDir = [
            path: {
                def cluster_rep_prefix = id.substring(0, id.length() - 2)
                "${params.outdir}/species_catalogue/${cluster_rep_prefix}/${id}/genome/"
            },
            pattern: "*.IPS.tsv",
            saveAs: { filename -> "${id}_interpro.tsv" },
            mode: 'copy'
        ]
    }
}

process {
    withName: EGGNOG_MAPPER_ANNOTATIONS_PER_GENOME {
        publishDir = [
            path: {
                def cluster_rep_prefix = id.substring(0, id.length() - 2)
                "${params.outdir}/species_catalogue/${cluster_rep_prefix}/${id}/genome/"
            },
            pattern: "*annotations",
            saveAs: { filename -> "${id}_eggNOG.tsv" },
            mode: 'copy'
        ]
    }
}

process {
    withName: GENERATE_EXTRA_WEIGHT {
        publishDir = [
        path: "${params.outdir}/additional_data/intermediate_files/",
        saveAs: { filename -> "extra_weight_table.txt" },
        mode: 'copy',
        enabled: !params.update_catalogue_path ? true : false
        ]
    }
}

process {
    withName: SPLIT_DREP_MAIN {
        publishDir = [
            path: "${params.outdir}/additional_data/intermediate_files",
            pattern: "clusters_split.txt",
            mode: "copy",
            failOnError: true
        ]
    }
}

process {
    withName: SPLIT_DREP_NEW_SPECIES {
        publishDir = [
        path: "${params.outdir}/additional_data/update_execution_reports",
        pattern: "split_output/clusters_split.txt",
        saveAs: { "clusters_split_new_species.txt" },
        mode: "copy",
        failOnError: true
        ]
    }
}

process {
    withName: PARSE_MASH_FOR_UPDATE {
        publishDir = [
        path: "${params.outdir}/additional_data/update_execution_reports",
        pattern: "mash_parse_results/*_strains.tsv",
        mode: 'copy',
        ]
    }
}

process {
    withName: RENAME_FASTA {
        publishDir = [
        path: "${params.outdir}/additional_data/intermediate_files",
        pattern: "*.tsv",
        saveAs: { "renamed_genomes_name_mapping.tsv" },
        mode: 'copy',
        enabled: !params.update_catalogue_path ? true : false,
        failOnError: true
        ]
    }
}

process {
    withName: RUN_CLUSTER_UPDATE {
        publishDir = [
            [
            path: "${params.outdir}/additional_data/intermediate_files",
            pattern: "update_clusters_split.txt",
            saveAs: { "clusters_split.txt" },
            mode: 'copy'
            ],
            [
            path: "${params.outdir}/additional_data/intermediate_files",
            pattern: "extra_weight_table_all_genomes.tsv",
            saveAs: { "extra_weight_table.txt" },
            mode: 'copy',
            enabled: params.update_catalogue_path ? true : false
            ],
            [
            path: "${params.outdir}/additional_data/update_execution_reports",
            pattern: "update_cluster_rep_changes_report.tsv",
            mode: 'copy'
            ],
            [
            path: "${params.outdir}/additional_data/intermediate_files",
            pattern: "update_renamed_genomes_name_mapping.tsv",
            saveAs: { "renamed_genomes_name_mapping.tsv" },
            mode: 'copy',
            enabled: params.update_catalogue_path ? true : false
            ]
        ]
    }
}
