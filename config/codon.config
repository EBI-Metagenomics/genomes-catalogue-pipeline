process {

    // TODO: The time needs to be adjusted
    time = '5d'

    withLabel:retry_twice {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel:retry_three_times {
        errorStrategy = 'retry'
        maxRetries    = 3
    }
    withLabel:ignore_errors {
        errorStrategy = 'ignore'
    }
    withLabel:process_light {
        cpus = 2
        memory = { 1.GB * task.attempt }
    }
    withLabel:process_medium {
        cpus = 8
        memory = { 48.GB * task.attempt }
    }

    // REPEAT_MODELER, REPEAT_MASKER, BRAKER, and METAEUK can run in parallel across samples.
    // We cap 32 CPUs x 11 forks for REPEAT_MODELER while the others stay at 16 CPUs x 23
    // forks. Maximum of 1456 CPUs in use at once (23x16 + 23x16 + 11x32 + 23x16).
    withName: BRAKER {
        cpus = 16
        memory = { 75.GB * task.attempt }
        time = { 16.h * task.attempt }
        maxForks = 23
    }
    withName: METAEUK {
        cpus = 16
        memory = { 75.GB * task.attempt }
        time = { 16.h * task.attempt }
        maxForks = 23
    }
    withName: REPEAT_MODELER {
        cpus = 32
        memory = { 50.GB * task.attempt }
        time = { 24.h * task.attempt }
        maxForks = 11
    }
    withName: REPEAT_MASKER {
        cpus = 16
        memory = { 50.GB * task.attempt }
        time = { 12.h * task.attempt }
        maxForks = 23
    }
    withName: DEDUP_GFF {
        cpus = 2
        memory = { 8.GB * task.attempt }
        time = 8.h
    }
    withName: 'EXTRACT_DEDUP_BRAKER_.*' {
        cpus = 2
        memory = { 8.GB * task.attempt }
        time = 8.h
    }
    withName: BUSCO {
        cpus = 8
        memory = { 500.GB * task.attempt }
        time = 8.h
    }
    withName: BUSCO_PROT{
        cpus = 8
        memory = { 20.GB * task.attempt }
        time = 8.h
    }
    withName: EUKCC {
        cpus = 8
        memory = { 36.GB * task.attempt }
        time = 8.h
    }
    withName: BAT {
        cpus = 16
        memory = { 72.GB * task.attempt }
        time = 8.h
    }
    withName: REFORMAT_BAT {
        cpus = 1
        memory = { 20.GB * task.attempt }
        time = 1.h
    } 
    withName: ANNOTATE_GFF {
        cpus = 1
        memory = { 1.GB * task.attempt }
        time = 4.h
    }
    withName: ANTISMASH {
        cpus = 4
        memory = { 2.GB * task.attempt }
        time = 8.h
    }
    withName: BUILD_MATRIX {
        cpus = 1
        memory = { task.attempt == 4 ? 500.GB : (10.GB * task.attempt) }
        time = 4.h
    }
    withName: CATALOGUE_SUMMARY {
        cpus = 1
        memory = { 2.GB * task.attempt }
    }
    withName: CHECKM2_NCBI {
        cpus = 32
        memory = { 50.GB * task.attempt }
    }
    withName: CHECKM2_CATALOGUE {
        cpus = 32
        memory = { 50.GB * task.attempt }
    }
    withName: CHECK_GENOME_VALIDITY {
        cpus = 16
        memory = { 1.GB * task.attempt }  
    }
    withName: CLASSIFY_CLUSTERS {
        cpus = 1
        memory = { 1.GB * task.attempt }
    }
    withName: CRISPRCAS_FINDER {
        cpus = 1
        memory = { 10.GB * task.attempt }
        time = 4.h
    }
    withName: DBCAN {
        cpus   = 8
        memory = { 10.GB * task.attempt }
        time = 8.h
    }
    withName: DEFENSE_FINDER {
        cpus = 1
        memory = { 2.GB * task.attempt }
        time = 8.h
    }
    withName: DETECT_NCRNA {
        cpus = 4
        memory = { 5.GB * task.attempt }
        time = 12.h
    }
    withName: DETECT_TRNA {
        cpus = 4
        memory = { 2.GB * task.attempt }
        time = 12.h
    }
    withName: DREP {
        cpus = 32
        memory = { 200.GB * task.attempt }
    }
    withName: DREP_CHUNKED {
        cpus = 32
        memory = { 200.GB * task.attempt }
    }
    withName: EGGNOG_MAPPER {
        cpus = 16
        memory = { 50.GB * task.attempt }
        time = 20.h
    }
    withName: FILTER_QS50 {
        cpus = 1
        memory = { 1.GB * task.attempt }
    }
    withName: FUNCTIONAL_ANNOTATION_SUMMARY {
        cpus = 1
        memory = { 1.GB * task.attempt }
    }
    withName: GECCO_RUN {
        cpus = 2
        memory = { 12.GB * task.attempt }
    }
    withName: GENE_CATALOGUE {
        cpus = 1
        memory = { task.attempt == 3 ? 1200.GB : (20.GB * task.attempt) }  // this can be very memory-demanding for large catalogues
    }
    withName: GENERATE_COMBINED_QC_REPORT {
        cpus = 1
        memory = { 100.MB * task.attempt }
    }
    withName: GENERATE_EXTRA_WEIGHT {
        cpus = 1
        memory = { 1.GB * task.attempt }
    }
    withName: GENOME_SUMMARY_JSON {
        cpus = 1
        memory = { 1.GB * task.attempt }
    }
    withName: GTDBTK_QC {
        cpus = 32
        memory = { 180.GB * task.attempt }
    }
    withName: GTDBTK_TAX {
        cpus = 32
        memory = { 180.GB * task.attempt }
    }
    withName: GUNC {
        cpus = 4
        memory = { 50.GB * task.attempt }
        time = 8.h
    }
    withName: PARSE_DOMAIN {
        cpus = 1
        memory = { 100.MB * task.attempt }
    }
    withName: INDEX_FNA {
        cpus = 1
        memory = { 500.MB * task.attempt }
        time = 8.h
    }
    withName: IPS {
        cpus = 16
        memory = { 40.GB * task.attempt }
        time = 20.h
        maxForks = 80
    }
    withName: IQTREE {
        cpus = 16
        memory = { 20.GB * task.attempt }
    }
    withName: FASTTREE {
        cpus = 1
        memory = { 20.GB * task.attempt }
    }
    withName: KEGG_COMPLETENESS {
        cpus = 1
        memory = { 1.GB * task.attempt }
        time = 4.h
    }
    withName: KRAKEN2_BUILD {
        cpus = 4
        memory = { 50.GB * task.attempt }
    }
    withName: BRACKEN {
        cpus = 4
        memory = { 40.GB * task.attempt }
    }
    withName: MASH_TO_NWK {
        cpus = 1
        memory = { 5.GB * task.attempt }
        time = 4.h
    }
    withName: MASH_SKETCH {
        cpus = 16
        memory = { 100.GB * task.attempt }
    }
    withName: MASH_FOR_UPDATE {
        cpus = 16
        memory = { 100.GB * task.attempt }
    }
    withName: MERGE_NCBI_ENA {
        cpus = 1
        memory = { 1.GB * task.attempt }
    }
    withName: METADATA_TABLE {
        cpus = 1
        memory = { 1.GB * task.attempt }
    }
    withName: MMSEQ {
        cpus = 32
        memory = { task.attempt == 3 ? 1500.GB : (100.GB * task.attempt) }  // low retries because they fill space
    }
    withName: PANAROO {
        cpus = 8
        memory = { task.attempt == 4 ? 500.GB : (3.GB * task.attempt) }
    }
    withName: PER_GENOME_ANNOTATION_GENERATOR {
        cpus = 16
        memory = { task.attempt == 4 ? 1400.GB : (250.GB * task.attempt) }
    }
    withName: PROTEIN_CATALOGUE_STORE_ANNOTATIONS {
        cpus = 1
        memory = { 10.GB * task.attempt }
        time = 22.h
    }
    withName: PHYLO_TREE {
        cpus = 1
        memory = { 1.GB * task.attempt }
    }
    withName: PROKKA {
        cpus = 8
        memory = { 20.GB * task.attempt }
        time = 2.h
    }
    withName: RENAME_FASTA {
        cpus = 1
        memory = { 500.MB * task.attempt }
    }
    withName: SPLIT_DREP {
        cpus = 1
        memory = { 1.GB * task.attempt }
    }
    withName: SANNTIS {
        cpus = 4
        memory = { 1.GB * task.attempt }
        time = 4.h
    }
}
