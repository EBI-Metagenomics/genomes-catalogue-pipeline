/*
    Caps the wall time of every task at 8 hours.

    Pass it as the last -c on the command line so that it takes precedence over the configs
    included by nextflow.config and by the selected profile, e.g.

        nextflow run main.nf -c <custom.config> -profile codon_slurm -c config/task_time_limit.config

    The '.*' withName selector is deliberate: a plain `process { time = ... }` is the least
    specific setting, so it would lose to every withLabel/withName block already in the repo
    (config/modules.config, config/codon*.config). A withName selector matching all processes
    sits at the same specificity as those blocks and, being declared last, wins.
*/

process {
    withName: '.*' {
        time = 8.h
    }
}
